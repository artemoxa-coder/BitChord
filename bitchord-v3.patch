@@ -0,0 +1,128 @@
+package com.music.bitchord.data.settings
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.net.Uri
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * A picture chosen from the gallery, shrunk and kept in the app's own files so
+ * it outlives the picker's permission. Returns a file:// address, or null when
+ * the picture could not be read. Each save gets a new file name, so a cached
+ * copy of the old picture is never shown in place of the new one.
+ */
+private fun saveScaledImage(context: Context, uri: Uri, folder: String, baseName: String, maxPx: Int): String? {
+    return runCatching {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+        var sample = 1
+        while (bounds.outWidth / (sample * 2) >= maxPx && bounds.outHeight / (sample * 2) >= maxPx) sample *= 2
+        val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+        val decoded = context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, opts) }
+            ?: return@runCatching null
+        val longest = maxOf(decoded.width, decoded.height)
+        val bitmap = if (longest > maxPx) {
+            val k = maxPx.toFloat() / longest
+            Bitmap.createScaledBitmap(
+                decoded,
+                (decoded.width * k).toInt().coerceAtLeast(1),
+                (decoded.height * k).toInt().coerceAtLeast(1),
+                true,
+            )
+        } else {
+            decoded
+        }
+        val dir = File(context.filesDir, folder).apply { mkdirs() }
+        dir.listFiles()?.filter { it.name.startsWith("$baseName-") }?.forEach { it.delete() }
+        val file = File(dir, "$baseName-${System.currentTimeMillis()}.jpg")
+        file.outputStream().use { bitmap.compress(Bitmap.CompressFormat.JPEG, 90, it) }
+        Uri.fromFile(file).toString()
+    }.getOrNull()
+}
+
+/** What the user chose to show instead of the signed-in account's own name and picture. */
+data class ProfileOverride(val name: String? = null, val avatar: String? = null)
+
+object ProfileOverrides {
+    private const val PREF_NAME = "bitchord_overrides"
+    private const val KEY_NAME = "profile_name"
+    private const val KEY_AVATAR = "profile_avatar"
+
+    private lateinit var prefs: SharedPreferences
+
+    private val _state = MutableStateFlow(ProfileOverride())
+    val state: StateFlow<ProfileOverride> = _state.asStateFlow()
+
+    fun init(context: Context) {
+        prefs = context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
+        _state.value = ProfileOverride(
+            name = prefs.getString(KEY_NAME, null)?.takeIf { it.isNotBlank() },
+            avatar = prefs.getString(KEY_AVATAR, null)?.takeIf { it.isNotBlank() },
+        )
+    }
+
+    /** An empty name puts the account's own name back. */
+    fun setName(name: String?) {
+        val clean = name?.trim()?.takeIf { it.isNotEmpty() }
+        if (this::prefs.isInitialized) {
+            prefs.edit().apply {
+                if (clean == null) remove(KEY_NAME) else putString(KEY_NAME, clean)
+            }.apply()
+        }
+        _state.value = _state.value.copy(name = clean)
+    }
+
+    fun setAvatar(context: Context, uri: Uri): Boolean {
+        val saved = saveScaledImage(context, uri, "profile", "avatar", 512) ?: return false
+        if (this::prefs.isInitialized) prefs.edit().putString(KEY_AVATAR, saved).apply()
+        _state.value = _state.value.copy(avatar = saved)
+        return true
+    }
+
+    fun reset() {
+        if (this::prefs.isInitialized) prefs.edit().remove(KEY_NAME).remove(KEY_AVATAR).apply()
+        _state.value = ProfileOverride()
+    }
+}
+
+/** Own covers for albums and playlists, by browse id. Only this device sees them. */
+object CoverOverrides {
+    private const val PREF_NAME = "bitchord_overrides"
+    private const val KEY_COVERS = "covers_json"
+
+    private lateinit var prefs: SharedPreferences
+
+    private val _map = MutableStateFlow<Map<String, String>>(emptyMap())
+    val map: StateFlow<Map<String, String>> = _map.asStateFlow()
+
+    fun init(context: Context) {
+        prefs = context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE)
+        val raw = prefs.getString(KEY_COVERS, null) ?: return
+        runCatching {
+            val obj = JSONObject(raw)
+            _map.value = obj.keys().asSequence().associateWith { obj.getString(it) }
+        }
+    }
+
+    fun set(context: Context, id: String, uri: Uri): Boolean {
+        val saved = saveScaledImage(context, uri, "covers", id.hashCode().toUInt().toString(16), 1024) ?: return false
+        update(_map.value + (id to saved))
+        return true
+    }
+
+    fun clear(id: String) {
+        _map.value[id]?.let { runCatching { File(Uri.parse(it).path.orEmpty()).delete() } }
+        update(_map.value - id)
+    }
+
+    private fun update(next: Map<String, String>) {
+        _map.value = next
+        if (this::prefs.isInitialized) prefs.edit().putString(KEY_COVERS, JSONObject(next).toString()).apply()
+    }
+}
