@@ -89,6 +89,49 @@ object LocalPlaylistStore {
         persist(updated)
     }
 
+    /**
+     * Stores [songs] as the new running order of the playlist [id]. Refused
+     * (false) unless they are exactly the tracks it already holds.
+     */
+    fun reorder(id: String, songs: List<Song>): Boolean {
+        val current = getPlaylist(id) ?: return false
+        if (songs.map { it.videoId }.sorted() != current.songs.map { it.videoId }.sorted()) return false
+        val updated = _playlists.value.map { if (it.id == current.id) it.copy(songs = songs) else it }
+        _playlists.value = updated
+        persist(updated)
+        return true
+    }
+
+    /**
+     * Takes one track (the first with this [videoId]) out of the playlist [id].
+     * False when the playlist or the track is not there.
+     */
+    fun removeSong(id: String, videoId: String): Boolean {
+        val current = getPlaylist(id) ?: return false
+        val at = current.songs.indexOfFirst { it.videoId == videoId }
+        if (at < 0) return false
+        val trimmed = current.songs.filterIndexed { i, _ -> i != at }
+        val updated = _playlists.value.map { if (it.id == current.id) it.copy(songs = trimmed) else it }
+        _playlists.value = updated
+        persist(updated)
+        return true
+    }
+
+    /**
+     * Adds [songs] to the end of the playlist [id], skipping any it already
+     * holds. Returns how many went in.
+     */
+    fun addSongs(id: String, songs: List<Song>): Int {
+        val current = getPlaylist(id) ?: return 0
+        val have = current.songs.mapTo(HashSet()) { it.videoId }
+        val fresh = songs.filter { it.videoId.isNotBlank() && have.add(it.videoId) }
+        if (fresh.isEmpty()) return 0
+        val updated = _playlists.value.map { if (it.id == current.id) it.copy(songs = it.songs + fresh) else it }
+        _playlists.value = updated
+        persist(updated)
+        return fresh.size
+    }
+
     fun getPlaylist(id: String): LocalPlaylist? {
         val cleanId = id.removePrefix("local:playlist:").removePrefix("VL")
         return _playlists.value.firstOrNull { it.id == cleanId || it.id == id || it.browseId == id }
