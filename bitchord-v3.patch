+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.IntOffset
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlin.math.roundToInt
+
+/**
+ * A thumb on the right edge for long lists: it shows while the list moves and
+ * can be dragged to jump a long way at once. Lists shorter than [minItems]
+ * get nothing, since the ordinary scroll covers them.
+ *
+ * Place it in a Box over the list, aligned to the end.
+ */
+@Composable
+fun FastScrollbar(
+    state: LazyListState,
+    modifier: Modifier = Modifier,
+    topPadding: Dp = 0.dp,
+    bottomPadding: Dp = 0.dp,
+    minItems: Int = 30,
+) {
+    val total by remember(state) { derivedStateOf { state.layoutInfo.totalItemsCount } }
+    if (total < minItems) return
+
+    var dragging by remember { mutableStateOf(false) }
+    var dragFraction by remember { mutableStateOf(0f) }
+    var shown by remember { mutableStateOf(false) }
+    val scrolling = state.isScrollInProgress
+
+    LaunchedEffect(scrolling, dragging) {
+        if (scrolling || dragging) {
+            shown = true
+        } else {
+            delay(1500)
+            shown = false
+        }
+    }
+
+    val scrollFraction by remember(state) {
+        derivedStateOf {
+            val info = state.layoutInfo
+            val maxFirst = (info.totalItemsCount - info.visibleItemsInfo.size).coerceAtLeast(1)
+            (state.firstVisibleItemIndex.toFloat() / maxFirst).coerceIn(0f, 1f)
+        }
+    }
+    val fraction = if (dragging) dragFraction else scrollFraction
+
+    BoxWithConstraints(
+        modifier = modifier
+            .fillMaxHeight()
+            .padding(top = topPadding, bottom = bottomPadding),
+    ) {
+        val thumbHeight = 56.dp
+        val trackPx = with(LocalDensity.current) { maxHeight.toPx() }
+        val thumbPx = with(LocalDensity.current) { thumbHeight.toPx() }
+        val travel = (trackPx - thumbPx).coerceAtLeast(1f)
+        val scope = rememberCoroutineScope()
+
+        AnimatedVisibility(
+            visible = shown,
+            enter = fadeIn(),
+            exit = fadeOut(),
+            modifier = Modifier.align(Alignment.TopEnd),
+        ) {
+            Box(
+                modifier = Modifier
+                    .offset { IntOffset(0, (fraction * travel).roundToInt()) }
+                    .width(18.dp)
+                    .height(thumbHeight)
+                    .pointerInput(total, travel) {
+                        detectVerticalDragGestures(
+                            onDragStart = {
+                                dragFraction = scrollFraction
+                                dragging = true
+                            },
+                            onDragEnd = { dragging = false },
+                            onDragCancel = { dragging = false },
+                        ) { change, dragAmount ->
+                            change.consume()
+                            dragFraction = (dragFraction + dragAmount / travel).coerceIn(0f, 1f)
+                            val target = (dragFraction * (total - 1)).roundToInt()
+                            scope.launch { state.scrollToItem(target) }
+                        }
+                    },
+                contentAlignment = Alignment.CenterEnd,
+            ) {
+                Box(
+                    modifier = Modifier
+                        .padding(end = 3.dp)
+                        .width(if (dragging) 8.dp else 5.dp)
+                        .fillMaxHeight()
+                        .background(
+                            MaterialTheme.colorScheme.onSurface.copy(alpha = 0.55f),
+                            RoundedCornerShape(50),
+                        ),
+                )
+            }
+        }
+    }
+}
