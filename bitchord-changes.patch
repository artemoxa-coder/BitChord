+    /**
+     * Stores [songs] as the new running order of a device playlist. Refused
+     * (false) for Liked, which is newest-first by design, and unless [songs]
+     * are exactly the tracks the playlist already holds.
+     */
+    fun reorder(browseId: String, songs: List<Song>): Boolean {
+        val id = browseId.removePrefix(PREFIX)
+        if (id == LIKED_ID) return false
+        var saved = false
+        mutate { list ->
+            list.map { playlist ->
+                if (playlist.id != id) return@map playlist
+                val same = songs.mapNotNull { it.localUri }.sorted() ==
+                    playlist.songs.mapNotNull { it.localUri }.sorted() &&
+                    songs.size == playlist.songs.size
+                if (!same) return@map playlist
+                saved = true
+                playlist.copy(songs = songs.map { it.stored() })
+            }
+        }
+        return saved
+    }
