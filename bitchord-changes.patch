+    /**
+     * Saves a new running order for a playlist kept on this device — one of
+     * the offline player's own, or a Spotify import — and puts the open page
+     * into that order. Nothing is sent anywhere. False when the store refused.
+     */
+    fun reorderLocalPlaylist(browseId: String, reordered: List<Song>): Boolean {
+        // The reorder page tags rows with throwaway slot ids; they are not the playlist's.
+        val songs = reordered.map { it.copy(setVideoId = null) }
+        val saved = if (OfflinePlaylists.isOfflinePlaylist(browseId)) {
+            OfflinePlaylists.reorder(browseId, songs)
+        } else {
+            com.music.bitchord.data.spotify.LocalPlaylistStore.reorder(browseId, songs)
+        }
+        if (!saved) return false
+        fun Song.slot() = localUri ?: videoId
+        val rank = HashMap<String, Int>()
+        songs.forEachIndexed { index, song -> rank[song.slot()] = index }
+        _detailStack.value = _detailStack.value.map { page ->
+            val shown = (page.songs as? UiState.Success)?.data
+            if (page.browseId != browseId || shown == null) {
+                page
+            } else {
+                page.copy(songs = UiState.Success(shown.sortedBy { rank[it.slot()] ?: Int.MAX_VALUE }))
+            }
+        }
+        return true
+    }
+
+    /**
+     * Takes one track out of a Spotify import kept on this device and off the
+     * open page. Nothing is sent anywhere, so no account is needed.
+     */
+    fun removeFromLocalPlaylist(browseId: String, song: Song) {
+        if (!com.music.bitchord.data.spotify.LocalPlaylistStore.removeSong(browseId, song.videoId)) return
+        _detailStack.value = _detailStack.value.map { page ->
+            val shown = (page.songs as? UiState.Success)?.data
+            if (page.browseId != browseId || shown == null) {
+                page
+            } else {
+                val at = shown.indexOfFirst { it.videoId == song.videoId }
+                if (at < 0) page else page.copy(songs = UiState.Success(shown.filterIndexed { i, _ -> i != at }))
+            }
+        }
+    }
